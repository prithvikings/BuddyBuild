{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",             /* Node.js uses CommonJS by default */
    "rootDir": "./src",               /* Where your .ts files are */
    "outDir": "./dist",               /* Where .js files go */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}